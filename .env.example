# Backend Server Port
PORT=5000

# MongoDB Connection URI (Atlas)
# Replace with your actual MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lms?retryWrites=true&w=majority

# Optional: Custom DNS for local development (resolves querySrv ECONNREFUSED on local ISP)
DNS_SERVERS=1.1.1.1,1.0.0.1

# Resend Email Configuration (for sending registration confirmation emails)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="LMS by Study Guru <noreply@studyguru.in>"

# Optional: Gmail API OAuth2 Credentials (fallback if Resend is not configured)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=contactsoftwarenative@gmail.com



